# Postgres (Neon). Contoh: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Rahasia sesi login. Buat dengan: openssl rand -base64 32
AUTH_SECRET=

# Login Google (opsional). Redirect URI: https://DOMAINMU/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# multi  = platform langganan: nama.domainmu.com per pelanggan
# single = satu situs saja (untuk template yang dijual sekali bayar)
MODE=multi

# Domain utama tanpa https://. Untuk lokal: localhost:3000
ROOT_DOMAIN=julexbz.com

# Alamat lengkap domain utama, dipakai untuk tautan "Dibuat dengan ..." dan tombol Buka situs
NEXT_PUBLIC_ROOT_URL=https://julexbz.com

# Pembayaran QRIS lewat Midtrans. Ambil di Midtrans Dashboard > Settings > Access Keys.
# Pakai kunci Sandbox dulu (diawali SB-Mid-server-). Jangan pernah dibagikan atau di-commit.
MIDTRANS_SERVER_KEY=
# sandbox (uji coba, uang tidak sungguhan) atau production
MIDTRANS_ENV=sandbox

# Email yang boleh menerbitkan situs tanpa bayar, pisahkan dengan koma (misalnya emailmu sendiri)
FREE_EMAILS=

# Email admin untuk halaman pembuat voucher (/admin/voucher). WAJIB diisi emailmu sendiri. Kosong = tidak ada admin.
ADMIN_EMAILS=

# Alamat situs milikmu yang tampil sebagai beranda julexbz.com (mode multi). Contoh: jika situsmu di julex.julexbz.com, isi julex.
# Kosongkan untuk menampilkan halaman pemasaran. Situs harus sudah terbit (pakai FREE_EMAILS agar gratis).
HOME_SLUG=
